5 DIM IP$(60)
10 IP$="N:TCP://<IP-Adresse einsetzen>:1883/"
20 STATE=0
30 PRINT "MQTT-TCP BEREIT. RETURN DRUECKEN!"
40 REM *** TASTATUR-SPEICHER ABFRAGEN ***
50 TASTE=PEEK(764)
60 IF TASTE<>12 THEN GOTO 50
70 REM *** SPEICHER ZURUECKSETZEN ***
75 POKE 764,255
80 STATE=1-STATE:PRINT "SENDE STATE: ";
90 IF STATE=1 THEN PRINT "ON"
100 IF STATE=0 THEN PRINT "OFF"
110 REM *** VERBINDUNG OEFFNEN ***
120 OPEN #1,12,0,IP$
130 REM *** STEP 1: MQTT CONNECT (TESTUSER / ATARI) ***
140 PUT #1,16:PUT #1,29:PUT #1,0:PUT #1,4
141 PUT #1,77:PUT #1,81:PUT #1,84:PUT #1,84
142 PUT #1,4:PUT #1,194:PUT #1,0:PUT #1,60
143 PUT #1,0:PUT #1,0:PUT #1,0:PUT #1,8
146 PUT #1,116:PUT #1,101:PUT #1,115:PUT #1,116
147 PUT #1,117:PUT #1,115:PUT #1,101:PUT #1,114
148 PUT #1,0:PUT #1,5:PUT #1,97:PUT #1,116
149 PUT #1,97:PUT #1,114:PUT #1,105
150 REM *** STEP 2: MQTT PUBLISH SENDER ***
170 IF STATE=1 THEN GOTO 210
180 REM *** PAYLOAD OFF (RETAINED) ***
190 PUT #1,49:PUT #1,12:PUT #1,0:PUT #1,7
191 PUT #1,65:PUT #1,116:PUT #1,97:PUT #1,114
192 PUT #1,105:PUT #1,88:PUT #1,76
193 PUT #1,79:PUT #1,70:PUT #1,70
200 GOTO 230
210 REM *** PAYLOAD ON (RETAINED) ***
220 PUT #1,49:PUT #1,11:PUT #1,0:PUT #1,7
221 PUT #1,65:PUT #1,116:PUT #1,97:PUT #1,114
222 PUT #1,105:PUT #1,88:PUT #1,76
223 PUT #1,79:PUT #1,78
230 REM *** VERBINDUNG SCHLIESSEN ***
240 CLOSE #1
250 REM *** KLEINE PAUSE GEGEN DOPPEL-TRIGGERS ***
270 FOR I=1 TO 200:NEXT I
280 GOTO 40
